# Copy to .env.local for local development, or add these in Railway → Variables.

# Resend API key, used to email enquiries from the contact form (https://resend.com)
RESEND_API_KEY=

# Where enquiries are sent. Defaults to contact.email in src/config/site.ts. Comma-separate several.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Thapsus website <website@thapsus.uk>"
